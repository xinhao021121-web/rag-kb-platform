# 企业级 RAG 知识库平台 · 本地运行配置
# 复制本文件为 .env 后填写；.env 不要提交到任何仓库。

PORT=8787

# 登录会话密钥（任意长随机字符串；不填则每次启动随机生成，重启后需重新登录）
SESSION_SECRET=

# ============ Dify（可选） ============
# Dify Cloud 使用 https://api.dify.ai/v1；自建实例通常为 http://<host>/v1
DIFY_BASE_URL=
# 数据集 API Key（用于创建 dataset、上传文档、查询切片、检索）
DIFY_DATASET_KEY=
# 文本生成应用 API Key（用于带引用回答；可选，缺省时使用抽取式回答）
DIFY_COMPLETION_KEY=
# 生成应用的用户标识（Dify 要求，随便填一个稳定字符串即可）
DIFY_APP_USER=rag-platform-local

# 检索默认参数
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.2
